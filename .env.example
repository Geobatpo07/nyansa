# Nyansa environment template.
# Copy to .env (local) or /opt/nyansa/shared/.env (production) and replace every
# placeholder. docs/DEPLOY.md lists the command that generates each secret.
# Values containing "$" (bcrypt hashes) MUST be wrapped in single quotes.

# ---------------------------------------------------------------------------
# Deployment (read by hooks/post-receive, ignored by Docker Compose)
# ---------------------------------------------------------------------------
# Compose profiles to start: one hardware profile (cpu | gpu-nvidia | gpu-amd)
# plus at most one access profile (public | tailscale). Space-separated.
NYANSA_PROFILES="cpu tailscale"
# Number of releases kept in /opt/nyansa/releases.
NYANSA_KEEP_RELEASES=5
# Seconds to wait for every container to become healthy after a deploy.
NYANSA_HEALTH_TIMEOUT=300

# ---------------------------------------------------------------------------
# PostgreSQL (n8n state)
# ---------------------------------------------------------------------------
POSTGRES_USER=nyansa_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=nyansa

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change_me_n8n_encryption_key
N8N_USER_MANAGEMENT_JWT_SECRET=change_me_n8n_jwt_secret
# Public URL of the n8n editor, without trailing slash.
#   public profile:    https://n8n.example.com
#   tailscale profile: https://nyansa.your-tailnet.ts.net:8443
#   local only:        http://localhost:5678
N8N_PUBLIC_URL=http://localhost:5678

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
WEBUI_SECRET_KEY=change_me_webui_secret_key
# Public URL of Open WebUI, without trailing slash.
WEBUI_PUBLIC_URL=http://localhost:3000
# Admin account created on first start, only if no user exists yet.
# Public sign-up is disabled, so this is the only way to create the first user.
WEBUI_ADMIN_NAME=Admin
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change_me_webui_admin_password

# ---------------------------------------------------------------------------
# Qdrant
# ---------------------------------------------------------------------------
# Required by every client (n8n, memory-api). Injected into the n8n Qdrant
# credential at runtime, never stored in the repository.
QDRANT_API_KEY=change_me_qdrant_api_key

# ---------------------------------------------------------------------------
# Obsidian vault and n8n shared folder (host paths)
# ---------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH=/path/to/obsidian-vault
# Host folder mounted at /data/shared in n8n. Use an absolute path outside the
# release directories in production (e.g. /opt/nyansa/shared/files).
NYANSA_FILES_PATH=./shared

# ---------------------------------------------------------------------------
# Access profile "public": Caddy on ports 80/443 with Let's Encrypt
# ---------------------------------------------------------------------------
ACME_EMAIL=admin@example.com
WEBUI_DOMAIN=chat.example.com
N8N_DOMAIN=n8n.example.com
# HTTP basic auth in front of the n8n editor (webhooks are exempt).
N8N_BASIC_AUTH_USER=nyansa
# bcrypt hash from: docker run --rm caddy:2.11.4-alpine caddy hash-password
N8N_BASIC_AUTH_HASH='$2a$14$replace.this.placeholder.with.a.real.bcrypt.hash.value'

# ---------------------------------------------------------------------------
# Access profile "tailscale": no public port, HTTPS on the tailnet
# ---------------------------------------------------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-replace-me
# Machine name on the tailnet and the tailnet DNS suffix.
TS_HOSTNAME=nyansa
TS_TAILNET=your-tailnet.ts.net

# ---------------------------------------------------------------------------
# Image versions (override to upgrade; defaults are pinned in docker-compose.yml)
# ---------------------------------------------------------------------------
# N8N_VERSION=2.40.7
# OLLAMA_VERSION=0.34.4
# QDRANT_VERSION=v1.19.1
# POSTGRES_VERSION=17.11-alpine
# OPEN_WEBUI_VERSION=v0.7.2
# CADDY_VERSION=2.11.4-alpine
# TAILSCALE_VERSION=v1.102.5

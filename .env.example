POSTGRES_USER=nyansa_admin
POSTGRES_PASSWORD=change_moi_un_vrai_mot_de_passe
POSTGRES_DB=nyansa

N8N_ENCRYPTION_KEY=colle_ici_une_cle_generee
N8N_USER_MANAGEMENT_JWT_SECRET=colle_ici_une_autre_cle_generee
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Vault Obsidian monté dans n8n (Syncthing plus tard, dossier local pour l'instant)
OBSIDIAN_VAULT_PATH=C:/Users/User/Documents/nyansa-vault

# For generating new keys, you can use the following PowerShell command:
# [System.Guid]::NewGuid().ToString()

# For Mac users running OLLAMA locally
# See https://github.com/n8n-io/self-hosted-ai-starter-kit?tab=readme-ov-file#for-mac--apple-silicon-users
# OLLAMA_HOST=host.docker.internal:11434

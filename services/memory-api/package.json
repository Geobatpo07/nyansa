{
  "name": "@nyansa/memory-api",
  "version": "0.1.0",
  "private": true,
  "description": "RAG ingestion and search service for the Nyansa Obsidian vault",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
